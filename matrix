class Matrix:
    def __init__(self, rows):
        self.rows = rows
        self.row_count = len(rows)
        self.col_count = len(rows[0])

    def multiply(self, other):
        # Check if multiplication is possible
        if self.col_count != other.row_count:
            raise ValueError("Matrix multiplication not possible")

        # Result matrix initialized with zeros
        result = [[0 for _ in range(other.col_count)] for _ in range(self.row_count)]

        # Matrix multiplication logic
        for i in range(self.row_count):
            for j in range(other.col_count):
                for k in range(self.col_count):
                    result[i][j] += self.rows[i][k] * other.rows[k][j]

        return Matrix(result)

    def display(self):
        for row in self.rows:
            print(row)


# Example usage
A = Matrix([[1, 2, 3],
            [4, 5, 6]])

B = Matrix([[7, 8],
            [9, 10],
            [11, 12]])

C = A.multiply(B)

print("Result of multiplication:")
C.display()
